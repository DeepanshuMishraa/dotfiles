# Ignore everything in the home directory by default.
/*

# Track only the selected dotfiles and their contents.
!/.gitignore
!/AGENTS.md
!/README.md
!/.zshrc
!/.agents/
!/.agents/**
!/.config/
!/.config/**
!/Scripts/
!/Scripts/**

# Track Pi configuration, themes, extensions, and package manifests.
!/.pi/
!/.pi/**
# Keep Pi dependencies and generated runtime state local.
/.pi/node_modules/
/.pi/ephemeral/
/.pi/context-mode/
/.pi/agent/auth.json
/.pi/agent/trust.json
/.pi/agent/run-history.jsonl
/.pi/agent/mcp-cache.json
/.pi/.DS_Store
/.pi/**/.DS_Store
/.pi/agent/sessions
/.pi/agent/missions/
/.pi/agent/skills/

# Track the Rift Borders source and its reproducible service definition.
!/Code/
/Code/*
!/Code/osc/
/Code/osc/*
!/Code/osc/borders/
!/Code/osc/borders/**
/Code/osc/borders/.build/
!/Library/
/Library/*
!/Library/LaunchAgents/
/Library/LaunchAgents/*
!/Library/LaunchAgents/com.dipxsy.rift-borders.plist

# Runtime PID files are recreated by the service and must stay local.
/.config/rift-borders/rift-borders.pid

# Keep Raycast's generated configuration and extensions local.
/.config/raycast/
/.config/raycast-x/
/.config/nvim/.undodir

# Keep Herdr's generated state local. Track only its config and plugin manifests.
/.config/herdr/*
!/.config/herdr/config.toml
!/.config/herdr/plugins.json
!/.config/herdr/plugins.txt

# Keep local credentials and generated authentication state out of Git.
/.config/dotfiles/secrets.env
/.config/github-copilot/auth.db
/.config/github-copilot/apps.json
/.config/herdr/*.log
/.config/herdr/session*.json
/.config/nowplaying/env
/.config/openclicky/secrets.env
/.config/fish/conf.d/secrets.fish
/.config/solana/id.json
# Keep Codeburn's machine-specific sharing identity and private key local.
/.config/codeburn/sharing/
# Keep all environment files local, even when they contain only non-secret values.
**/*.env

# Ignore dependencies nested anywhere in tracked directories.
**/node_modules/
