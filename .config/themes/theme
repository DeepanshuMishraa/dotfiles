def pi_theme(theme: dict[str, Any], name: str) -> dict[str, Any]:
    p = theme["palette"]
    vars_ = {k: color(p, k, "#000000") for k in REQUIRED_COLORS if k not in {"accent", "active_space_bg"}}
    vars_.update({
        "surface2": color(p, "separator", "#404040"), "base": color(p, "panel_bg", "#000000"),
        "mantle": color(p, "active_space_bg", "#000000"), "crust": color(p, "surface_dim", "#000000"),
        "subtext1": color(p, "overlay1", "#808080"), "overlay2": color(p, "overlay0", "#808080"),
        "rosewater": color(p, "text", "#ffffff"), "flamingo": color(p, "peach", "#ffff00"),
        "pink": color(p, "mauve", "#ff00ff"), "maroon": color(p, "red", "#ff0000"),
        "sky": color(p, "blue", "#0000ff"), "sapphire": color(p, "teal", "#00ffff"),
        "lavender": color(p, "accent", "#0000ff"), "toolErrorBg": color(p, "surface1", "#404040"),
    })
    return {"name": name, "vars": vars_, "colors": PI_COLORS, "export": {
        "pageBg": color(p, "active_space_bg", "#000000"), "cardBg": color(p, "panel_bg", "#000000"),
        "infoBg": color(p, "surface0", "#404040"),
    }}


def set_pi(theme: dict[str, Any], dry: bool) -> Path:
    path = HOME / ".pi" / "agent" / "settings.json"
    settings = read_json(path)
    name = theme["targets"].get("pi") or theme["name"]
    settings["theme"] = name
    if not dry:
        write_json(path, settings)
        target = path.parent / "themes" / f"{name}.json"
        if not target.exists() or name == "herdr-global":
            write_json(target, pi_theme(theme, name))
    return path


def nvim_lua(theme: dict[str, Any]) -> str:
    p = theme["palette"]
    c = lambda key, fallback: color(p, key, fallback)
    groups = {
        "Normal": (c("text", "#ffffff"), c("panel_bg", "#000000")),
        "NormalFloat": (c("text", "#ffffff"), c("panel_bg", "#000000")),
        "CursorLine": (None, c("surface0", "#404040")), "LineNr": (c("overlay0", "#808080"), None),
        "CursorLineNr": (c("overlay1", "#ffffff"), None), "Visual": (None, c("surface1", "#404040")),
        "Search": (c("text", "#ffffff"), c("surface1", "#404040")),
        "IncSearch": (c("surface_dim", "#000000"), c("accent", "#0000ff")),
        "StatusLine": (c("text", "#ffffff"), c("active_space_bg", "#000000")),
        "StatusLineNC": (c("overlay0", "#808080"), c("surface_dim", "#000000")),
        "WinSeparator": (c("separator", "#404040"), None), "Pmenu": (c("text", "#ffffff"), c("surface0", "#404040")),
        "PmenuSel": (c("text", "#ffffff"), c("surface1", "#404040")), "Comment": (c("overlay0", "#808080"), None),
        "String": (c("green", "#00ff00"), None), "Number": (c("peach", "#ffff00"), None),
        "Function": (c("blue", "#0000ff"), None), "Identifier": (c("blue", "#0000ff"), None),
        "Keyword": (c("mauve", "#ff00ff"), None), "Type": (c("teal", "#00ffff"), None),
        "Operator": (c("teal", "#00ffff"), None), "DiagnosticError": (c("red", "#ff0000"), None),
        "DiagnosticWarn": (c("yellow", "#ffff00"), None), "DiagnosticInfo": (c("blue", "#0000ff"), None),
        "DiagnosticHint": (c("teal", "#00ffff"), None), "DiffAdd": (c("green", "#00ff00"), c("surface_dim", "#000000")),
        "DiffChange": (c("yellow", "#ffff00"), c("surface_dim", "#000000")),
        "DiffDelete": (c("red", "#ff0000"), c("surface_dim", "#000000")),
    }
    lines = ["-- Generated by `theme set` — do not edit manually", 'vim.g.colors_name = "herdr-sync"', "", "local h = vim.api.nvim_set_hl"]
    for group, (fg, bg) in groups.items():
        attrs = []
        if fg: attrs.append(f'fg = "{fg}"')
        if bg: attrs.append(f'bg = "{bg}"')
        if group == "Comment": attrs.append("italic = true")
        lines.append(f'h(0, "{group}", {{ {", ".join(attrs)} }})')
    return "\n".join(lines) + "\n"


def set_neovim(theme: dict[str, Any], dry: bool) -> Path:
    candidates = [CONFIG / "nvim/lua/plugins/color-scheme.lua", CONFIG / "nvim/lua/dipxsy/plugins/color-scheme.lua", CONFIG / "nvim/init.lua"]
    path = next(path for path in candidates if path.exists())
    content = path.read_text(encoding="utf-8")
    if 'require("herdr-sync")' not in content and not re.search(r"(?:vim\.cmd\.)?colorscheme", content):
        raise ThemeError("no Neovim colorscheme hook found")
    if not dry:
        atomic_write(CONFIG / "nvim/lua/herdr-sync.lua", nvim_lua(theme))
    return path


