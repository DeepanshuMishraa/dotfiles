    cache = read_json(path) if path.exists() else {}
    cache["hacktui-theme"] = theme["targets"].get("hacktui", theme["name"])
    if not dry: write_json(path, cache)
    return path


def detected_adapters() -> list[tuple[str, Callable[[dict[str, Any], bool], Path]]]:
    adapters: list[tuple[str, Callable[[dict[str, Any], bool], Path]]] = [("herdr", set_herdr)]
    checks = [
        ("pi-agent", HOME / ".pi/agent/settings.json", set_pi),
        ("neovim", CONFIG / "nvim", set_neovim), ("zed", CONFIG / "zed/settings.json", set_zed),
        ("tmux", CONFIG / "tmux/tmux.conf", set_tmux), ("ghostty", CONFIG / "ghostty/config", set_ghostty),
        ("opencode", CONFIG / "opencode/tui.json", set_opencode), ("termy", CONFIG / "termy/config.txt", set_termy),
    ]
    adapters.extend((name, fn) for name, path, fn in checks if path.exists())
    if (HOME / ".bun/bin/hacktui").exists() or Path("/usr/local/bin/hacktui").exists():
        adapters.append(("hacktui", set_hacktui))
    return adapters


def command_list(_: argparse.Namespace) -> int:
    themes = available()
    current = None
    if STATE.exists():
        try: current = read_json(STATE).get("theme")
        except ThemeError: pass
    for name in themes:
        print(f"{name}{' *' if name == current else ''}")
    return 0


def command_status(_: argparse.Namespace) -> int:
    if not STATE.exists():
        print("No global theme has been applied yet.")
        return 1
    state = read_json(STATE)
    print(f"theme: {state.get('theme', 'unknown')}")
    print(f"applied: {state.get('applied_at', 'unknown')}")
    for name, entry in state.get("tools", {}).items():
        print(f"{name}: {entry.get('status', 'updated')} ({entry.get('config')})")
    return 0


def command_set(args: argparse.Namespace) -> int:
    theme = load_theme(args.name)
    results: dict[str, dict[str, str]] = {}
    errors = 0
    for name, adapter in detected_adapters():
        try:
            path = adapter(theme, args.dry_run)
            status = "would update" if args.dry_run else "updated"
            results[name] = {"status": status, "config": str(path)}
            print(f"{name:<10} {status:<12} {path}")
        except (ThemeError, OSError, ValueError, TypeError) as error:
            message = str(error)
            skipped = name == "tmux" and "not Catppuccin" in message
            status = "skipped" if skipped else "error"
            errors += 0 if skipped else 1
            results[name] = {"status": status, "config": message}
            print(f"{name:<10} {status:<12} {message}")
    if not args.dry_run:
        write_json(STATE, {"theme": theme["name"], "applied_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"), "tools": results})
        if results.get("ghostty", {}).get("status") == "updated":
            try:
                reload_ghostty()
                print("ghostty    scheduled    /usr/bin/killall -31 ghostty (after command exit)")
            except ThemeError as error:
                errors += 1
                results["ghostty"] = {"status": "error", "config": str(error)}
                write_json(STATE, {"theme": theme["name"], "applied_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"), "tools": results})
                print(f"ghostty    error        {error}")
    return 1 if errors else 0


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="theme", description="Synchronize a theme across development tools")
    commands = root.add_subparsers(dest="command", required=True)
    listing = commands.add_parser("list", help="list installed themes"); listing.set_defaults(func=command_list)
    status = commands.add_parser("status", help="show the last applied theme"); status.set_defaults(func=command_status)
    setting = commands.add_parser("set", help="apply a theme to all detected tools")
    setting.add_argument("name"); setting.add_argument("--dry-run", action="store_true"); setting.set_defaults(func=command_set)
    return root


def main() -> int:
    try:
        args = parser().parse_args()
        return args.func(args)
    except ThemeError as error:
        print(f"theme: {error}", file=sys.stderr); return 2


if __name__ == "__main__":
    raise SystemExit(main())
