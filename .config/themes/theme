HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
THEMES = CONFIG / "themes"
STATE = THEMES / "settings.json"
REQUIRED_COLORS = {
    "accent", "panel_bg", "surface0", "active_space_bg", "surface1",
    "surface_dim", "separator", "overlay0", "overlay1", "text", "subtext0",
    "mauve", "green", "yellow", "red", "blue", "teal", "peach",
}


class ThemeError(Exception):
    pass


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode if path.exists() else 0o644
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as handle:
            handle.write(content)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def read_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ThemeError(f"cannot read {path}: {error}") from error


def write_json(path: Path, value: Any) -> None:
    atomic_write(path, json.dumps(value, indent=2, ensure_ascii=False) + "\n")


def available() -> dict[str, Path]:
    found: dict[str, Path] = {}
    if not THEMES.is_dir():
        return found
    for path in sorted(THEMES.glob("*.json")):
        if path == STATE:
            continue
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(data, dict) and isinstance(data.get("name"), str) and isinstance(data.get("palette"), dict):
            found[data["name"]] = path
    return found


def load_theme(name: str) -> dict[str, Any]:
    normalized = name.lower().replace("_", "-").replace(" ", "-")
    aliases = {
        "mocha": "catppuccin-mocha", "macchiato": "catppuccin-macchiato",
        "latte": "catppuccin-latte", "light": "catppuccin-latte",
        "tokyonight": "tokyo-night", "tokyo-day": "tokyo-night-day",
        "gruvbox-dark": "gruvbox", "onedark": "one-dark", "onelight": "one-light",
        "solarized-dark": "solarized", "lotus": "kanagawa-lotus",
        "rosepine": "rose-pine", "rosepine-dawn": "rose-pine-dawn", "dawn": "rose-pine-dawn",
    }
    normalized = aliases.get(normalized, normalized)
    path = available().get(normalized)
    if path is None:
        raise ThemeError(f"unknown theme: {name} (run `theme list`)")
    data = read_json(path)
    missing = REQUIRED_COLORS.difference(data["palette"])
    if missing:
        raise ThemeError(f"{path.name} is missing palette colors: {', '.join(sorted(missing))}")
    if not isinstance(data.get("targets"), dict):
        raise ThemeError(f"{path.name} has no targets object")
    return data


def color(palette: dict[str, str], key: str, fallback: str) -> str:
    value = palette.get(key, fallback)
    return fallback if value == "default" else value


def replace_setting(content: str, key: str, value: str) -> str:
    pattern = re.compile(rf"^(\s*{re.escape(key)}\s*=\s*).*$", re.MULTILINE)
    if pattern.search(content):
        return pattern.sub(lambda m: m.group(1) + value, content, count=1)
    suffix = "" if not content or content.endswith("\n") else "\n"
    return content + suffix + f"{key} = {value}\n"


def set_herdr(theme: dict[str, Any], dry: bool) -> Path:
    path = CONFIG / "herdr" / "config.toml"
    content = path.read_text(encoding="utf-8") if path.exists() else ""
    name = theme["targets"].get("herdr", theme["name"])
    lines = content.splitlines()
    section = next((i for i, line in enumerate(lines) if line.strip() == "[theme]"), None)
    quoted = json.dumps(name)
    if section is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines.extend(["[theme]", f"name = {quoted}"])
    else:
        end = next((i for i in range(section + 1, len(lines)) if re.match(r"^\s*\[", lines[i])), len(lines))
        key_line = next((i for i in range(section + 1, end) if re.match(r"^\s*name\s*=", lines[i])), None)
        if key_line is None:
            lines.insert(section + 1, f"name = {quoted}")
        else:
            indent = lines[key_line][:-len(lines[key_line].lstrip())]
            lines[key_line] = f"{indent}name = {quoted}"
    if not dry:
        atomic_write(path, "\n".join(lines) + "\n")
        herdr = shutil.which("herdr")
        if herdr:
            subprocess.run([herdr, "server", "reload-config"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return path


