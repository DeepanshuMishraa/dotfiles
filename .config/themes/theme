def set_tmux(theme: dict[str, Any], dry: bool) -> Path:
    path = CONFIG / "tmux/tmux.conf"
    flavour = theme["targets"].get("tmux_flavour")
    if not flavour:
        raise ThemeError("not Catppuccin-based; existing tmux plugin has no matching flavour")
    content = path.read_text(encoding="utf-8")
    pattern = re.compile(r"^(\s*set(?:-option)?\s+-g\s+@catppuccin_flavour\s+)(['\"]?)[^'\"\s]+\2(.*)$", re.MULTILINE)
    if not pattern.search(content):
        raise ThemeError("@catppuccin_flavour is not configured")
    updated = pattern.sub(lambda m: f"{m.group(1)}'{flavour}'{m.group(3)}", content, count=1)
    if not dry:
        atomic_write(path, updated)
        if os.environ.get("TMUX") and shutil.which("tmux"):
            subprocess.run(["tmux", "source-file", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return path


def set_ghostty(theme: dict[str, Any], dry: bool) -> Path:
    path = CONFIG / "ghostty/config"
    content = path.read_text(encoding="utf-8")
    updated = replace_setting(content, "background", theme["targets"]["ghostty_background"])
    if not dry:
        generated = CONFIG / "ghostty/themes/herdr-global"
        atomic_write(generated, ghostty_theme(theme))
        atomic_write(path, updated)
        if sys.platform == "darwin":
            mac_config = HOME / "Library/Application Support/com.mitchellh.ghostty/config"
            if mac_config.exists():
                mac_content = mac_config.read_text(encoding="utf-8")
                mac_updated = replace_setting(mac_content, "theme", str(generated))
                atomic_write(mac_config, mac_updated)
    return path


def ghostty_theme(theme: dict[str, Any]) -> str:
    """Render a complete Ghostty color theme from a global palette."""
    p = theme["palette"]
    c = lambda key, fallback: color(p, key, fallback)
    ansi = [
        c("active_space_bg", "#000000"), c("red", "#ff0000"),
        c("green", "#00ff00"), c("yellow", "#ffff00"),
        c("blue", "#0000ff"), c("mauve", "#ff00ff"),
        c("teal", "#00ffff"), c("text", "#ffffff"),
        c("surface0", "#404040"), c("red", "#ff8080"),
        c("green", "#80ff80"), c("yellow", "#ffff80"),
        c("blue", "#8080ff"), c("mauve", "#ff80ff"),
        c("teal", "#80ffff"), c("subtext0", "#ffffff"),
    ]
    lines = [
        "# Generated by `theme set` — do not edit manually",
        f"foreground = {c('text', '#ffffff')}",
        f"background = {theme['targets']['ghostty_background']}",
        f"cursor-color = {c('text', '#ffffff')}",
        f"cursor-text = {c('panel_bg', '#000000')}",
        f"selection-foreground = {c('text', '#ffffff')}",
        f"selection-background = {c('surface1', '#404040')}",
    ]
    lines.extend(f"palette = {index}={value}" for index, value in enumerate(ansi))
    return "\n".join(lines) + "\n"


def reload_ghostty() -> None:
    """Schedule Ghostty's reload after this theme process has exited."""
    killall = Path("/usr/bin/killall")
    if not killall.exists():
        raise ThemeError("Ghostty config updated, but /usr/bin/killall is unavailable")
    log_path = THEMES / "ghostty-reload.log"
    script = (
        "sleep 0.5; "
        "/usr/bin/killall -31 ghostty; "
        "ghostty_reload_status=$?; "
        f"printf 'command=/usr/bin/killall -31 ghostty\\nexit_status=%s\\n' "
        f"\"$ghostty_reload_status\" > {shlex.quote(str(log_path))}; "
        "exit \"$ghostty_reload_status\""
    )
    try:
        subprocess.Popen(
            ["/bin/sh", "-c", script],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    except OSError as error:
        raise ThemeError(f"could not schedule Ghostty reload: {error}") from error


