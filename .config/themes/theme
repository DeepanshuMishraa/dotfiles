TERMY_KEYS = ["foreground", "background", "cursor", "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white", "bright_black", "bright_red", "bright_green", "bright_yellow", "bright_blue", "bright_magenta", "bright_cyan", "bright_white"]


def termy_colors(theme: dict[str, Any]) -> dict[str, str]:
    p = theme["palette"]
    c = lambda key, fallback: color(p, key, fallback)
    return {"foreground": c("text", "#ffffff"), "background": c("panel_bg", "#000000"), "cursor": c("text", "#ffffff"),
            "black": c("active_space_bg", "#000000"), "red": c("red", "#ff0000"), "green": c("green", "#00ff00"),
            "yellow": c("yellow", "#ffff00"), "blue": c("blue", "#0000ff"), "magenta": c("mauve", "#ff00ff"),
            "cyan": c("teal", "#00ffff"), "white": c("text", "#ffffff"), "bright_black": c("surface0", "#404040"),
            "bright_red": c("red", "#ff0000"), "bright_green": c("green", "#00ff00"), "bright_yellow": c("yellow", "#ffff00"),
            "bright_blue": c("blue", "#0000ff"), "bright_magenta": c("mauve", "#ff00ff"),
            "bright_cyan": c("teal", "#00ffff"), "bright_white": c("subtext0", "#808080")}


def set_termy(theme: dict[str, Any], dry: bool) -> Path:
    path = CONFIG / "termy/config.txt"
    content = path.read_text(encoding="utf-8")
    colors = termy_colors(theme)
    content = replace_setting(content, "theme", "herdr")
    content = replace_setting(content, "theme_mode", "manual")
    lines = content.splitlines()
    headers = [i for i, line in enumerate(lines) if line.strip() == "[colors]"]
    if len(headers) > 1: raise ThemeError("multiple [colors] sections")
    if headers:
        start = headers[0] + 1
        end = next((i for i in range(start, len(lines)) if lines[i].strip().startswith("[") and lines[i].strip().endswith("]")), len(lines))
    else:
        if lines and lines[-1].strip(): lines.append("")
        lines.append("[colors]")
        start = len(lines); end = len(lines)
    found: set[str] = set()
    for index in range(start, end):
        match = re.match(r"^\s*([A-Za-z_]+)\s*=", lines[index])
        if match and match.group(1) in colors:
            key = match.group(1); lines[index] = f"{key} = {colors[key]}"; found.add(key)
    lines[end:end] = [f"{key} = {colors[key]}" for key in TERMY_KEYS if key not in found]
    if not dry:
        write_json(CONFIG / "termy/themes/herdr.json", {"$schema": "../../../schemas/theme.schema.json", **colors})
        atomic_write(path, "\n".join(lines) + "\n")
    return path


def set_hacktui(theme: dict[str, Any], dry: bool) -> Path:
