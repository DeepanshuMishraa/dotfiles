#!/usr/bin/env bash

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# Monochrome palette from unsecretised/Sketchybar-Config.
BG_BASE="0x1f1f28"
BG_SURFACE="0x2a2a37"
FG_PRIMARY="0xdcd7ba"
FG_SECONDARY="0xc8c093"
FG_DIM="0x727169"
ACTIVE_SPACE_BG="0x2a2a37"
ACCENT="0xdcd7ba"
GREEN="0x98bb6c"
YELLOW="0xe6c384"
RED="0xe46876"
FONT="Spline Sans Mono"
ICON_FONT="Hack Nerd Font"

COLORS_FILE="$CONFIG_DIR/colors.sh"
if [ -r "$COLORS_FILE" ]; then
  # Generated by Hued from the active semantic palette.
  source "$COLORS_FILE"
fi

sketchybar --bar position=top \
                display=all \
                show_in_fullscreen=on \
                height=28 \
                color=0x00000000 \
                shadow=off \
                sticky=on \
                padding_left=8 \
                padding_right=8 \
                corner_radius=0 \
                border_width=0 \
                blur_radius=0 \
                y_offset=0 \
                margin=0 \
                notch_width=0

default=(
  padding_left=3
  padding_right=3
  icon.font="$ICON_FONT:Bold:11.0"
  label.font="$FONT:Regular:10.0"
  icon.color=0x80${FG_DIM:2}
  label.color=0xff${FG_PRIMARY:2}
  icon.padding_left=4
  icon.padding_right=2
  label.padding_left=2
  label.padding_right=4
  background.color=0x00000000
  background.corner_radius=6
  background.height=20
  background.border_width=0
  background.border_color=0x00000000
  background.shadow.drawing=off
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
  display="$(aerospace list-workspaces --all \
    --format '%{workspace}:%{monitor-appkit-nsscreen-screens-id}' \
    | awk -F: -v workspace="$sid" '$1 == workspace { print $2; exit }')"

  sketchybar --add item "workspace.$sid" left \
             --set "workspace.$sid" \
               associated_display="$display" \
               icon="$sid" \
               icon.font="$ICON_FONT:Bold:10.0" \
               icon.color=0x80${FG_DIM:2} \
               icon.highlight_color=0xff${ACCENT:2} \
               icon.padding_left=5 \
               icon.padding_right=1 \
               label.drawing=off \
               label.font="$ICON_FONT:Regular:9.0" \
               label.padding_right=4 \
               label.padding_left=1 \
               background.color=0x00000000 \
               background.corner_radius=5 \
               background.border_width=0 \
               background.border_color=0x40${FG_DIM:2} \
               background.height=18 \
               click_script="aerospace workspace $sid"
done

sketchybar --add item sep.left left \
           --set sep.left icon= \
                          icon.font="$ICON_FONT:Bold:12.0" \
                          icon.color=0x30${FG_DIM:2} \
                          icon.padding_left=2 \
                          icon.padding_right=2 \
                          background.drawing=off \
                          label.drawing=off

sketchybar --add item front_app left \
           --set front_app icon.drawing=off \
                           label.color=0xff${FG_SECONDARY:2} \
                           label.font="$FONT:Bold:10.0" \
                           label.padding_left=2 \
                           label.padding_right=5 \
                           script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

sketchybar --add item clock right \
           --set clock icon=󰥔 \
                       icon.font="$ICON_FONT:Regular:11.0" \
                       icon.color=0x80${FG_DIM:2} \
                       label.color=0xff${FG_PRIMARY:2} \
                       label.font="$FONT:Bold:10.0" \
                       label.padding_right=1 \
                       update_freq=1 \
                       script="$PLUGIN_DIR/clock.sh" \
                       click_script="$PLUGIN_DIR/calendar_popup.sh toggle" \
                       popup.align=right \
                       popup.height=22 \
                       popup.y_offset=4 \
                       popup.background.color=0xf0${BG_BASE:2} \
                       popup.background.corner_radius=10 \
                       popup.background.border_width=1 \
                       popup.background.border_color=0x40${FG_DIM:2} \
                       popup.background.shadow.drawing=off \
           --subscribe clock mouse.exited.global

calendar_popup_items=(
  "calendar.title:󰃭"
  "calendar.weekdays:"
  "calendar.week.1:"
  "calendar.week.2:"
  "calendar.week.3:"
  "calendar.week.4:"
  "calendar.week.5:"
  "calendar.week.6:"
  "calendar.open:󰒓"
)
for item in "${calendar_popup_items[@]}"; do
  IFS=: read -r name icon <<< "$item"
  sketchybar --add item "$name" popup.clock \
             --set "$name" icon="$icon" \
                           icon.font="$ICON_FONT:Regular:11.0" \
                           icon.color=0xff${ACCENT:2} \
                           icon.padding_left=8 \
                           icon.padding_right=5 \
                           label.font="$FONT:Regular:10.0" \
                           label.color=0xff${FG_PRIMARY:2} \
                           label.width=174 \
                           label.align=center \
                           label.padding_left=0 \
                           label.padding_right=0 \
                           width=190 \
                           padding_left=0 \
                           padding_right=0 \
                           background.drawing=off \
                           background.shadow.drawing=off
done
sketchybar --set calendar.title label.font="$FONT:Bold:10.0" \
                                      label.padding_left=0 \
                                      background.drawing=on \
                                      background.color=0x40${BG_SURFACE:2} \
                                      background.corner_radius=6 \
                                      background.height=20 \
           --set calendar.weekdays label.color=0xff${FG_SECONDARY:2} \
                                        label.font="$FONT:Bold:10.0" \
           --set calendar.open label="Open Calendar…" \
                                     label.align=left \
                                     label.width=154 \
                                     background.drawing=on \
                                     background.color=0x40${BG_SURFACE:2} \
                                     background.corner_radius=6 \
                                     background.height=20 \
                                     click_script="$PLUGIN_DIR/calendar_popup.sh open"

sketchybar --add item sep.right1 right \
           --set sep.right1 icon= \
                            icon.font="$ICON_FONT:Bold:12.0" \
                            icon.color=0x30${FG_DIM:2} \
                            icon.padding_left=2 \
                            icon.padding_right=2 \
                            background.drawing=off \
                            label.drawing=off

sketchybar --add item battery right \
           --set battery icon=󰁹 \
                         icon.font="$ICON_FONT:Regular:11.0" \
                         icon.color=0x80${FG_DIM:2} \
                         label.color=0xff${FG_SECONDARY:2} \
                         label.font="$FONT:Regular:10.0" \
                         label.padding_right=1 \
                         update_freq=60 \
                         script="$PLUGIN_DIR/battery.sh" \
                         click_script="$PLUGIN_DIR/battery_popup.sh toggle" \
                         popup.align=right \
                         popup.height=24 \
                         popup.y_offset=4 \
                         popup.background.color=0xf0${BG_BASE:2} \
                         popup.background.corner_radius=10 \
                         popup.background.border_width=1 \
                         popup.background.border_color=0x40${FG_DIM:2} \
                         popup.background.shadow.drawing=off \
           --subscribe battery system_woke power_source_change mouse.exited.global

battery_popup_items=(
  "battery.charge:󰁹:Charge"
  "battery.source:󰚥:Power Source"
  "battery.health:󰄬:Battery Health"
  "battery.cycles:󰑓:Cycle Count"
  "battery.settings:󰒓:Battery Settings…"
)
for item in "${battery_popup_items[@]}"; do
  IFS=: read -r name icon label <<< "$item"
  sketchybar --add item "$name" popup.battery \
             --set "$name" icon="$icon" \
                           icon.font="$ICON_FONT:Regular:11.0" \
                           icon.color=0xff${ACCENT:2} \
                           icon.padding_left=8 \
                           icon.padding_right=5 \
                           label="$label" \
                           label.font="$FONT:Regular:10.0" \
                           label.color=0xff${FG_PRIMARY:2} \
                           label.padding_left=0 \
                           label.padding_right=9 \
                           background.color=0x40${BG_SURFACE:2} \
                           background.corner_radius=6 \
                           background.height=20 \
                           background.shadow.drawing=off
done
sketchybar --set battery.settings click_script="$PLUGIN_DIR/battery_popup.sh settings"

sketchybar --add item wifi right \
           --set wifi icon=󰖩 \
                      icon.font="$ICON_FONT:Regular:11.0" \
                      icon.color=0x80${FG_DIM:2} \
                      label.drawing=off \
                      label.color=0xff${FG_SECONDARY:2} \
                      label.font="$FONT:Regular:10.0" \
                      label.padding_right=1 \
                      update_freq=30 \
                      script="$PLUGIN_DIR/wifi.sh" \
                      click_script="$PLUGIN_DIR/wifi_popup.sh toggle" \
                      popup.align=right \
                      popup.height=24 \
                      popup.y_offset=4 \
                      popup.background.color=0xf0${BG_BASE:2} \
                      popup.background.corner_radius=10 \
                      popup.background.border_width=1 \
                      popup.background.border_color=0x40${FG_DIM:2} \
                      popup.background.shadow.drawing=off \
           --subscribe wifi wifi_change system_woke mouse.exited.global

wifi_popup_items=(
  "wifi.connection:󰖩:Wi-Fi"
  "wifi.signal:󰤨:Signal"
  "wifi.address:󰩟:IP Address"
  "wifi.toggle:󰐥:Toggle Wi-Fi"
  "wifi.settings:󰒓:Network Settings…"
)
for item in "${wifi_popup_items[@]}"; do
  IFS=: read -r name icon label <<< "$item"
  sketchybar --add item "$name" popup.wifi \
             --set "$name" icon="$icon" \
                           icon.font="$ICON_FONT:Regular:11.0" \
                           icon.color=0xff${ACCENT:2} \
                           icon.padding_left=8 \
                           icon.padding_right=5 \
                           label="$label" \
                           label.font="$FONT:Regular:10.0" \
                           label.color=0xff${FG_PRIMARY:2} \
                           label.padding_left=0 \
                           label.padding_right=9 \
                           background.color=0x40${BG_SURFACE:2} \
                           background.corner_radius=6 \
                           background.height=20 \
                           background.shadow.drawing=off
done
sketchybar --set wifi.toggle click_script="$PLUGIN_DIR/wifi_popup.sh power" \
           --set wifi.settings click_script="$PLUGIN_DIR/wifi_popup.sh settings"

sketchybar --add item sep.right2 right \
           --set sep.right2 icon= \
                            icon.font="$ICON_FONT:Bold:12.0" \
                            icon.color=0x30${FG_DIM:2} \
                            icon.padding_left=2 \
                            icon.padding_right=2 \
                            background.drawing=off \
                            label.drawing=off

sketchybar --add item volume right \
           --set volume icon=󰕾 \
                        icon.font="$ICON_FONT:Regular:11.0" \
                        icon.color=0x80${FG_DIM:2} \
                        label.color=0xff${FG_SECONDARY:2} \
                        label.font="$FONT:Regular:10.0" \
                        label.padding_right=1 \
                        script="$PLUGIN_DIR/volume.sh" \
                        click_script="$PLUGIN_DIR/volume_popup.sh toggle" \
                        popup.align=right \
                        popup.height=24 \
                        popup.y_offset=4 \
                        popup.background.color=0xf0${BG_BASE:2} \
                        popup.background.corner_radius=10 \
                        popup.background.border_width=1 \
                        popup.background.border_color=0x40${FG_DIM:2} \
                        popup.background.shadow.drawing=off \
           --subscribe volume volume_change mouse.exited.global

sketchybar --add slider volume.slider popup.volume 130 \
           --set volume.slider slider.percentage=50 \
                               slider.highlight_color=0xff${ACCENT:2} \
                               slider.background.color=0x50${FG_DIM:2} \
                               slider.background.height=4 \
                               slider.knob=● \
                               slider.knob.font="$FONT:Bold:10.0" \
                               slider.knob.color=0xff${FG_PRIMARY:2} \
                               padding_left=10 \
                               padding_right=10 \
                               background.color=0x40${BG_SURFACE:2} \
                               background.corner_radius=6 \
                               background.height=20 \
                               script="$PLUGIN_DIR/volume_popup.sh" \
           --subscribe volume.slider mouse.clicked volume_change

volume_popup_items=(
  "volume.output:󰓃:Output"
  "volume.mute:󰖁:Mute"
  "volume.settings:󰒓:Sound Settings…"
)
for item in "${volume_popup_items[@]}"; do
  IFS=: read -r name icon label <<< "$item"
  sketchybar --add item "$name" popup.volume \
             --set "$name" icon="$icon" \
                           icon.font="$ICON_FONT:Regular:11.0" \
                           icon.color=0xff${ACCENT:2} \
                           icon.padding_left=8 \
                           icon.padding_right=5 \
                           label="$label" \
                           label.font="$FONT:Regular:10.0" \
                           label.color=0xff${FG_PRIMARY:2} \
                           label.padding_left=0 \
                           label.padding_right=9 \
                           background.color=0x40${BG_SURFACE:2} \
                           background.corner_radius=6 \
                           background.height=20 \
                           background.shadow.drawing=off
done
sketchybar --set volume.output click_script="$PLUGIN_DIR/volume_popup.sh output" \
           --set volume.mute click_script="$PLUGIN_DIR/volume_popup.sh mute" \
           --set volume.settings click_script="$PLUGIN_DIR/volume_popup.sh settings"

MUSIC_EVENT="com.apple.Music.playerInfo"
sketchybar --add event music_change "$MUSIC_EVENT"
sketchybar --add item music right \
           --set music icon= \
                       icon.font="$ICON_FONT:Regular:11.0" \
                       icon.color=0x80${FG_DIM:2} \
                       label.drawing=off \
                       script="$PLUGIN_DIR/music.sh" \
                       click_script="$PLUGIN_DIR/music_popup.sh toggle" \
                       popup.horizontal=on \
                       popup.align=center \
                       popup.background.color=0xf0${BG_BASE:2} \
                       popup.background.corner_radius=14 \
                       popup.background.border_width=1 \
                       popup.background.border_color=0x40${FG_DIM:2} \
                       popup.background.shadow.drawing=off \
           --subscribe music music_change mouse.clicked mouse.exited.global

sketchybar --add item music.track popup.music \
           --set music.track icon.drawing=off \
                             label="Not Playing" \
                             label.color=0xff${FG_PRIMARY:2} \
                             label.font="$FONT:Bold:10.0" \
                             label.padding_left=9 \
                             label.padding_right=9 \
                             background.color=0x50${BG_SURFACE:2} \
                             background.corner_radius=6 \
                             background.height=20

controls=("back:󰒮" "play:󰐊" "next:󰒭" "shuffle:󰒝" "repeat:󰑖")
for control in "${controls[@]}"; do
  IFS=: read -r name icon <<< "$control"
  sketchybar --add item "music.$name" popup.music \
             --set "music.$name" icon="$icon" \
                                 icon.font="$ICON_FONT:Regular:13.0" \
                                 icon.color=0xcc${FG_DIM:2} \
                                 icon.highlight_color=0xff${ACCENT:2} \
                                 label.drawing=off \
                                 background.color=0x50${BG_SURFACE:2} \
                                 background.corner_radius=6 \
                                 background.border_width=1 \
                                 background.border_color=0x30${FG_DIM:2} \
                                 background.shadow.drawing=off \
                                 script="$PLUGIN_DIR/music.sh" \
             --subscribe "music.$name" mouse.clicked music_change
done

sketchybar --add item workspaces_updater left \
           --set workspaces_updater drawing=off \
                                    update_freq=2 \
                                    script="$PLUGIN_DIR/aerospace.sh" \
           --subscribe workspaces_updater aerospace_workspace_change

sketchybar --add bracket left_group \
             '/workspace\..*/' '/sep\.left/' '/front_app/' \
           --set left_group background.color=0xd0${BG_BASE:2} \
                            background.corner_radius=10 \
                            background.height=24 \
                            background.border_width=1 \
                            background.border_color=0x30${FG_DIM:2} \
                            background.shadow.drawing=off

sketchybar --add bracket right_group \
             '/clock/' '/sep\.right*/' '/battery/' '/wifi/' '/volume/' '/music/' \
           --set right_group background.color=0xd0${BG_BASE:2} \
                             background.corner_radius=10 \
                             background.height=24 \
                             background.border_width=1 \
                             background.border_color=0x30${FG_DIM:2} \
                             background.shadow.drawing=off

sketchybar --update
