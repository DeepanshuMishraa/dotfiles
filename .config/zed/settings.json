{
  "status_bar": {
    "experimental.show": false
  },
  "debugger": {
    "button": false
  },
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "button": false,
    "default_model": {
      "effort": "high",
      "enable_thinking": false,
      "model": "gpt-5.3-codex",
      "provider": "copilot_chat"
    },
    "default_profile": "write",
    "model_parameters": [],
    "tool_permissions": {
      "tools": {
        "edit_file": {
          "default": "allow"
        }
      }
    }
  },
  "allow_rewrap": "anywhere",
  "autosave": {
    "after_delay": {
      "milliseconds": 10
    }
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "MonoLisa",
  "buffer_font_size": 18,
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15
  },
  "chat_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "file_finder": {
    "modal_width": "medium"
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules"
  ],
  "file_types": {
    "Dockerfile": [
      "Dockerfile",
      "Dockerfile.*"
    ],
    "JSON": [
      "json",
      "jsonc",
      "*.code-snippets"
    ]
  },
  "git_panel": {
    "dock": "right"
  },
  "icon_theme": {
    "dark": "Flow Deep",
    "light": "Catppuccin Macchiato",
    "mode": "dark"
  },
  "indent_guides": {
    "coloring": "indent_aware",
    "enabled": true
  },
  "inlay_hints": {
    "enabled": false
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434"
    }
  },
  "languages": {
    "Python": {
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "language_servers": [
        "pyright",
        "ruff"
      ]
    },
    "TypeScript": {
      "inlay_hints": {
        "enabled": false,
        "show_other_hints": false,
        "show_parameter_hints": false,
        "show_type_hints": false
      }
    }
  },
  "lsp": {
    "rust-analyzer": {
          "initialization_options": {
            "inlayHints": {
              "maxLength": null,
              "lifetimeElisionHints": {
                "enable": "skip_trivial",
                "useParameterNames": true
              },
              "closureReturnTypeHints": {
                "enable": "always"
              }
            }
          }},
    "tailwindcss-language-server": {
      "settings": {
        "classAttributes": [
          "class",
          "className",
          "ngClass",
          "styles"
        ]
      }
    },
    "vtsls": {
      "enable_lsp_tasks": true,
      "settings": {
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      }
    }
  },
  "notification_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "button": false,
    "dock": "right"
  },
  "project_panel": {
    "button": true,
    "dock": "right",
    "git_status": true
  },
  "toolbar":{
    "breadcrumbs": false,
    "quick_actions": false,
     "selections_menu": false,
     "agent_review": false,
     "code_actions": false
  },
  "buffer_font_fallbacks": ["Hack Nerd Font Mono"],
  "relative_line_numbers": "enabled",
  "scrollbar": {
    "show": "never"
  },
  "seed_search_query_from_cursor": "never",
  "soft_wrap": "editor_width",
  "tab_bar": {
    "show": true
  },
  "tabs": {
    "show_diagnostics": "errors"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "dock": "bottom",
    "env": {
      "EDITOR": "zed --wait"
    },
    "font_family": "MonoLisa",
  },
  "theme": {
    "mode": "dark",
    "light": "hued light",
    "dark": "Rosé Pine"
  },
  "ui_font_family": "MonoLisa",
  "ui_font_size": 17,
  "vim": {
    "enable_vim_sneak": true
  },
  "vim_mode": false
}
