# AeroSpace config
# Based on: https://nikitabobko.github.io/AeroSpace/guide

config-version = 2

# Highlight the focused windo with JankyBorders
after-startup-command = [
  'exec-and-forget borders active_color=0xffe1e3e4 inactive_color=0xff494d64 width=5.0'
]

# Start AeroSpace automatically on login
start-at-login = true

# Apply future config edits immediately
auto-reload-config = true

# Keep utility and capture apps out of the tiling tree
on-window-detected = [
  { if = 'test %{app-bundle-id} = com.objective-see.lulu.app', run = 'layout floating' },
  { if = 'test %{app-bundle-id} = com.timpler.screenstudio', run = 'layout floating' },
  { if = 'test %{app-bundle-id} = cc.ffitch.shottr', run = 'layout floating' },
  { if = 'test %{app-bundle-id} = com.apple.calculator', run = 'layout floating' },
  { if = 'test %{app-bundle-id} = co.meldstudio.MeldStudio', run = 'layout floating' },
  { if = 'test %{app-bundle-id} = com.apple.finder', run = 'layout floating' },
  { if = 'test %{app-bundle-id} = ru.keepcoder.Telegram', run = 'layout floating' },

]

# Normalizations keep the tree clean and sane
enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true

# Layout: tiles = grid-like side-by-side
# Orientation: auto = wide monitors get horizontal, tall get vertical
accordion-padding = 30
default-root-container-layout = 'tiles'
default-root-container-orientation = 'auto'

# Do NOT move mouse when focus changes — prevents new windows from spawning
# on the other display when focus accidentally crosses monitors
on-focused-monitor-changed = []

# Disable macOS "Hide application" (cmd-h) since it's useless with a tiling WM
automatically-unhide-macos-hidden-apps = true

# Only keep workspaces 1-4 alive
persistent-workspaces = ["1", "2", "3", "4"]
enable-normalization-bsp-shape = true
enable-normalization-bsp-shape = true
# Gaps
[gaps]
inner.horizontal = 8
inner.vertical =   8
outer.left =       8
outer.bottom =     8
outer.top =        8
outer.right =      8

# Key mapping
[key-mapping]
preset = 'qwerty'

# ── Main binding mode ─────────────────────────────────────────────
[mode.main.binding]

# Focus within current workspace (STAYS on current display)
alt-h = 'focus --boundaries workspace --boundaries-action stop left'
alt-j = 'focus --boundaries workspace --boundaries-action stop down'
alt-k = 'focus --boundaries workspace --boundaries-action stop up'
alt-l = 'focus --boundaries workspace --boundaries-action stop right'

# Move window within the tree
alt-shift-h = 'move left'
alt-shift-j = 'move down'
alt-shift-k = 'move up'
alt-shift-l = 'move right'

# Focus display / jump to other monitor explicitly
alt-ctrl-h = 'focus-monitor left'
alt-ctrl-j = 'focus-monitor down'
alt-ctrl-k = 'focus-monitor up'
alt-ctrl-l = 'focus-monitor right'

# Workspaces
alt-1 = 'workspace 1'
alt-2 = 'workspace 2'
alt-3 = 'workspace 3'
alt-4 = 'workspace 4'

# Move window to workspace (same hand position as workspace switching)
alt-shift-1 = 'move-node-to-workspace 1'
alt-shift-2 = 'move-node-to-workspace 2'
alt-shift-3 = 'move-node-to-workspace 3'
alt-shift-4 = 'move-node-to-workspace 4'

# Disable macOS "Hide" shortcuts (useless with a tiling WM)
cmd-h = []
cmd-alt-h = []

# Toggle floating
alt-f = 'layout floating tiling'

# Fullscreen
alt-shift-f = 'fullscreen'

# Toggle layout orientation
alt-slash = 'layout tiles horizontal vertical'

# Toggle accordion (stacked)
alt-comma = 'layout accordion horizontal vertical'

# Resize
alt-minus = 'resize smart -50'
alt-equal = 'resize smart +50'
alt-0 = 'balance-sizes'

# Quick switch without taking over macOS/app tab switching
alt-backtick = 'workspace-back-and-forth'

# Move the current workspace between monitors
ctrl-alt-shift-h = 'move-workspace-to-monitor --wrap-around left'
ctrl-alt-shift-j = 'move-workspace-to-monitor --wrap-around down'
ctrl-alt-shift-k = 'move-workspace-to-monitor --wrap-around up'
ctrl-alt-shift-l = 'move-workspace-to-monitor --wrap-around right'

# Join-with (group windows under a common parent)
alt-semicolon = 'mode join'

# Service mode
alt-shift-backtick = 'mode service'

# ── Join mode (press alt + semicolon to enter) ─────────────────────
[mode.join.binding]
esc = 'mode main'
h = ['join-with left',  'mode main']
j = ['join-with down',  'mode main']
k = ['join-with up',    'mode main']
l = ['join-with right', 'mode main']

# ── Service mode (press alt + shift + ` to enter) ─────────────────
[mode.service.binding]
esc = ['reload-config', 'mode main']
r = ['flatten-workspace-tree', 'mode main']
f = ['layout floating tiling', 'mode main']
backspace = ['close-all-windows-but-current', 'mode main']

# Disable hide app shortcuts in service mode too
cmd-h = []
cmd-alt-h = []
